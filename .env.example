# Copier ce fichier en ".env" (non versionne) pour personnaliser le mot de
# passe de la base PostgreSQL locale, utilise a la fois par docker-compose.yml
# et par data-transformer/src/main/resources/application.properties.
#
# Sans ce fichier, la valeur par defaut "datatransformer_pass" est utilisee (dev local
# uniquement, ne jamais garder cette valeur pour un environnement partage).

DB_PASSWORD=datatransformer_pass
